---

<MainLayout 
  title="Kemampuan & Tech Stack | Rahman Qolbi" 
  description="Daftar keahlian teknis dan teknologi web yang dikuasai Rahman Qolbi, termasuk HTML, CSS, JavaScript, Astro, Tailwind CSS, Bootstrap, dan Flutter."
  keywords="Tech Stack, Skill Web Developer, HTML, CSS, JavaScript, Tailwind CSS, Bootstrap, Flutter, Astro JS"
>
  <article id="Kemampuan" class="w-full max-w-[600px] mx-auto lg:max-w-none flex flex-col items-center justify-center p-6 sm:p-8 lg:p-8 bg-forest-sage rounded-[28px] lg:rounded-[50px] shadow-tactile-double flex-grow">
    <h1 class="text-center text-lg md:text-2xl font-black mb-6 md:mb-8 text-white">Kemampuan</h1>
    <div class="flex flex-row flex-wrap justify-center w-full gap-6 md:gap-8">
      {skills.map((skill) => (
        <div class="group flex flex-col items-center justify-center p-4 max-w-[130px] w-full bg-[#235d2e] rounded-[24px] shadow-[4px_4px_1px_rgba(18,51,25,0.65),_-3px_-3px_1px_rgba(216,233,168,0.15)] hover:-translate-y-0.5 hover:shadow-[5px_5px_2px_rgba(18,51,25,0.75),_-4px_-4px_2px_rgba(216,233,168,0.22)] transition-all cursor-default">
          <div class={`mb-3 flex items-center justify-center ${skill.color}`} set:html={skill.svg} />
          <p class="text-sm font-bold text-center text-lime-bud">{skill.name}</p>
        </div>
      ))}
    </div>
  </article>
</MainLayout>


---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Rahman Qolbi | Web Developer & Frontend Engineer Portfolio"
  description="Portofolio resmi Rahman Qolbi, Web & Frontend Developer. Dokumentasi proyek web development, eksperimen koding, dan pembuatan produk digital modern."
  keywords="Rahman Qolbi, Web Developer, Frontend Engineer, Portfolio Web, Astro JS, Tailwind CSS, JavaScript Developer"
>
  <article id="Home" class="w-full max-w-[600px] mx-auto lg:max-w-none flex flex-col justify-center p-6 sm:p-8 lg:p-10 bg-forest-sage rounded-[28px] lg:rounded-[50px] shadow-tactile-double flex-grow">
    <div class="w-full max-w-[500px]">
      <!-- Warm Cozy Eyebrow Greeting -->
      <p class="text-xs font-sora font-semibold text-lime-bud/75 tracking-wider mb-3">
        salam kenal.
      </p>
      
      <!-- Premium Display Heading -->
      <h1 class="text-3xl md:text-5xl font-sora font-extrabold text-white mb-5 leading-[1.15] tracking-tight">
        Selamat datang<br />
        <span class="text-lime-bud">di sini.</span>
      </h1>
      
      <!-- Casual, Highly Readable Body Copy -->
      <p class="text-sm md:text-base font-manrope text-white/85 leading-relaxed mb-6">
        Di sini saya naruh proyek-proyek yang pernah saya kerjakan. Nggak ada yang terlalu serius — cuma dokumentasi sederhana dari proses saya ngoding. Semua ini saya bangun sambil terus belajar dan mencoba hal baru.
      </p>
      
      <!-- Elegant Faded Divider -->
      <div class="h-[1px] w-32 bg-gradient-to-r from-lime-bud/30 via-lime-bud/10 to-transparent mb-5"></div>
      
      <!-- Charming Personal Sign-off -->
      <p class="text-xs font-sora font-semibold italic text-lime-bud/60 tracking-wide">
        semoga ada yang menarik buat kamu
      </p>
    </div>
  </article>
</MainLayout>


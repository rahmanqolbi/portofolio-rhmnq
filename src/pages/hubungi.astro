---
import MainLayout from '../layouts/MainLayout.astro';

// Konfigurasi nomor WhatsApp Anda
const WHATSAPP_NUMBER = "6285163564569"; 
---

<MainLayout title="Hubungi Saya | Rahman Qolbi" description="Hubungi Rahman Qolbi langsung melalui WhatsApp secara mudah dan cepat.">
  <article id="Hubungi" class="flex-[3] w-full max-w-[600px] mx-auto lg:max-w-none flex flex-col items-center justify-center p-6 lg:p-8 bg-forest-sage rounded-[28px] lg:rounded-[50px] shadow-tactile-double flex-grow">
    <div class="flex flex-col items-center w-full max-w-[500px]">
      <!-- Header Bersih Tanpa Subtitle -->
      <h1 class="text-center text-lg md:text-2xl font-black mb-8">Hubungi Saya</h1>

      <form id="contact-terminal" data-phone={WHATSAPP_NUMBER} class="w-full flex flex-col gap-6">
        <!-- Field: Nama -->
        <div class="flex flex-col gap-1.5">
          <label for="form-name" class="text-xs font-bold text-lime-bud/80 tracking-wide font-sora">Nama Kamu</label>
          <input 
            type="text" 
            id="form-name" 
            required 
            placeholder="Tulis nama kamu disini..."
            class="w-full px-4 py-3 bg-shadow-dark/60 rounded-[14px] text-sm text-white/95 placeholder-lime-bud/30 font-manrope border border-lime-bud/10 shadow-[inset_3px_3px_5px_rgba(0,0,0,0.5)] focus:outline-none focus:border-lime-bud/50 transition-colors"
          />
        </div>

        <!-- Field: Pesan -->
        <div class="flex flex-col gap-1.5">
          <label for="form-message" class="text-xs font-bold text-lime-bud/80 tracking-wide font-sora">Isi Pesan</label>
          <textarea 
            id="form-message" 
            required 
            rows="5" 
            placeholder="Tulis apa saja yang ingin kamu sampaikan..."
            class="w-full px-4 py-3 bg-shadow-dark/60 rounded-[18px] text-sm text-white/95 placeholder-lime-bud/30 font-manrope border border-lime-bud/10 shadow-[inset_3px_3px_5px_rgba(0,0,0,0.5)] focus:outline-none focus:border-lime-bud/50 transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Kirim Button (Dengan Loading State Terintegrasi) -->
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3.5 mt-2 bg-shadow-light rounded-[16px] shadow-[4px_4px_0px_var(--color-shadow-dark),_-2px_-2px_0px_rgba(216,233,168,0.15)] border border-lime-bud/15 text-lime-bud font-sora font-extrabold text-sm tracking-wider cursor-pointer hover:border-lime-bud/40 active:translate-y-[2px] active:shadow-[1px_1px_0px_var(--color-shadow-dark)] transition-all flex items-center justify-center gap-2"
        >
          <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span id="btn-text">Kirim via WhatsApp</span>
        </button>
      </form>
    </div>

    <!-- Client Script -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('contact-terminal');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const btnText = document.getElementById('btn-text');

        if (form && submitBtn && btnText) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const nameEl = document.getElementById('form-name') as HTMLInputElement | null;
            const messageEl = document.getElementById('form-message') as HTMLTextAreaElement | null;

            if (!nameEl || !messageEl) return;

            const name = nameEl.value;
            const message = messageEl.value;
            const phone = form.getAttribute('data-phone') || "6285163564569";

            // Efek Loading Profesional Langsung di Dalam Tombol
            submitBtn.disabled = true;
            submitBtn.style.opacity = "0.8";
            btnText.innerText = "Membuka WhatsApp...";

            setTimeout(() => {
              const formattedText = `Halo Rahman! Saya *${name}* dari website portofolio.\n\n*Pesan:*\n${message}`;
              const waLink = `https://wa.me/${phone}?text=${encodeURIComponent(formattedText)}`;
              
              window.open(waLink, '_blank');

              // Kembalikan status tombol setelah beberapa saat
              setTimeout(() => {
                if (submitBtn && btnText) {
                  submitBtn.disabled = false;
                  submitBtn.style.opacity = "1";
                  btnText.innerText = "Kirim via WhatsApp";
                }
              }, 2000);
            }, 800);
          });
        }
      });
    </script>
  </article>
</MainLayout>

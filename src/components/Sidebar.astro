    </a>
    <a 
      href="/hubungi" 
      class="w-10 h-10 flex items-center justify-center bg-shadow-light rounded-[12px] shadow-[3px_3px_0px_var(--color-shadow-dark),_-2px_-2px_0px_rgba(216,233,168,0.15)] border border-lime-bud/10 hover:border-lime-bud/30 active:translate-y-[2px] active:shadow-[1px_1px_0px_var(--color-shadow-dark)] transition-all cursor-pointer text-lime-bud hover:text-white"
      aria-label="Halaman Kontak Rahman Qolbi"

  transition:persist
>

  <!-- Wadah Bingkai Layar CRT (Console Screen Bezel) -->
  <div class="p-1.5 bg-shadow-light rounded-[24px] shadow-[-4px_4px_1px_rgba(18,51,25,0.65),_3px_-3px_1px_rgba(216,233,168,0.15)] mb-3">

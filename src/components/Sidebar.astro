  <h2 class="text-lg lg:text-xl font-extrabold text-lime-bud">Rahman Qolbi</h2>
  <h3 class="text-[10px] lg:text-xs font-bold text-white/45 tracking-widest mt-0.5 uppercase font-mono">
    Tech & Coding Enthusiast
  </h3>

  <!-- Status Belajar Santai (Warm, Human Status) -->

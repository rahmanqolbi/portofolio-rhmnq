      src="/img/biodata.png" 
      alt="Foto Profil Rahman Qolbi - Web & Frontend Developer" 
      class="max-w-[140px] max-h-[140px] lg:max-w-[175px] lg:max-h-[175px] rounded-[18px] block" 
      width="175" 
      height="175" 
      decoding="sync"
    />
